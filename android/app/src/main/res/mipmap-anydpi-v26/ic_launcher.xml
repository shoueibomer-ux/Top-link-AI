<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher masks these layers itself, so the
     roundel is no longer shrunk into a light circle with a ring around it.
     Layers are generated by tool/make_adaptive_icon.py. Below API 26 the
     plain mipmap-*/ic_launcher.png is used instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
